{
  "name": "commerce-hub/v1-starter",
  "description": "Starter skeleton for WooCommerce Allegro eBay order integrator with InPost shipping",
  "type": "project",
  "require": {
    "php": "^8.1",
    "laravel/framework": "^8.83",
    "laravel/sanctum": "^2.15"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "nunomaduro/collision": "^5.11"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/",
      "Database\\Factories\\": "database/factories/"
    }
  }
}
